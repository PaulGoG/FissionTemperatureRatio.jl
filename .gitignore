# Input data is held locally for development and testing, not shipped with the package.
# Its provenance and the terms it came under are documented in data/README.md, which is tracked.
/data/*
!/data/README.md

# Generated results and figures
/plots/
/data/sims/

# Resolved environments. This package supports a range of Julia versions and a manifest is
# resolved against one of them, so committing one breaks instantiation on the others. The versions
# a run actually used are recorded in its metadata instead.
Manifest.toml
**/Manifest.toml

# Julia artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem
/docs/build/
/docs/site/
LocalPreferences.toml

# Editor and OS
.vscode/
.idea/
*~
.DS_Store
